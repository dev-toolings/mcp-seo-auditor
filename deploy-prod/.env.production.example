# ── MCP Server ──
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_AUTH_TOKEN=replace-with-a-long-random-token
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=sk-ant-...
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
SQLITE_DB_PATH=/app/data/seo_auditor.db
REPORT_RETENTION_HOURS=168
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-credentials.json
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GITHUB_TOKEN=ghp_...
PROMPT_LANGUAGE=en

# ── Logging ──
LOG_LEVEL=INFO
LOG_JSON=true

# ── Caddy ──
DOMAIN=localhost
