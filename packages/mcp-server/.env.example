# SEO Auditor Configuration

# API Settings
API_HOST=0.0.0.0
API_PORT=8020
API_DEBUG=true

# Remote MCP authentication. HTTP transport refuses to start without a token
# unless ALLOW_UNAUTHENTICATED_HTTP is explicitly enabled for isolated dev.
MCP_AUTH_TOKEN=
ALLOW_UNAUTHENTICATED_HTTP=false

# Autonomous audit-to-PR agent (disabled by default)
SEO_AGENT_ENABLED=false
SEO_AGENT_PROVIDER=auto
SEO_AGENT_PROVIDER_ORDER=codex,claude,grok
SEO_AGENT_MODEL=
SEO_AGENT_ALLOWED_ROOTS=/workspace
# Optional custom runtime override; leave empty for Codex -> Claude -> Grok detection.
SEO_AGENT_RUNTIME_CONFIG=
SEO_AGENT_WORKTREE_ROOT=/app/data/agent-worktrees
SEO_AGENT_ARTIFACT_ROOT=/app/data/agent-runs
SEO_AGENT_SKILL_ROOTS=/workspace/.codex/skills
SEO_AGENT_MAX_CONCURRENT_RUNS=2
SEO_AGENT_MAX_FILES=50
SEO_AGENT_MAX_DIFF_LINES=5000
SEO_AGENT_MAX_RUN_MINUTES=60
SEO_AGENT_MAX_REPAIR_CYCLES=2
SEO_AGENT_MAX_CLI_SECONDS=1800

# Default target for audits
DEFAULT_SITEMAP_URL=http://localhost:3000/sitemap.xml
DEFAULT_BASE_URL=http://localhost:3000

# CORS Origins (comma-separated)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:8080

# Crawler Settings
CRAWLER_TIMEOUT=30
CRAWLER_MAX_CONCURRENT=10
CRAWLER_USER_AGENT=MCPSEOAuditor/1.0

# Content Analysis
MIN_CONTENT_WORDS=100
THIN_CONTENT_THRESHOLD=50

# Cannibalization Detection
SIMILARITY_THRESHOLD=0.7
MIN_KEYWORD_FREQUENCY=2

# Report Storage
REPORT_RETENTION_HOURS=24

# ===========================================
# Google Search Console (OPTIONAL)
# ===========================================
# Path to service account JSON credentials
# See docs/GOOGLE_SEARCH_CONSOLE_SETUP.md for setup
# GSC is auto-detected: if credentials exist, tools are available.
# Use gsc_list_sites to discover properties, then pass site_url to each tool.
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-credentials.json

# GSC Rate Limiting (requests per minute)
# Standard API calls: 60 RPM max, default 50 (safe margin)
# URL Inspection: 10 RPM max ("low rate"), default 8
GSC_REQUESTS_PER_MINUTE=50
GSC_INSPECTION_RPM=8

# ===========================================
# LLM Configuration (OPTIONAL)
# ===========================================
# Provider: "anthropic", "openai", "ollama", "" = disabled
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# Chrome DevTools Configuration (OPTIONAL)
# ===========================================
# Enable Chrome DevTools integration for local audits
CHROME_DEVTOOLS_ENABLED=true

# Run Chrome in headless mode (no GUI)
CHROME_DEVTOOLS_HEADLESS=true

# Viewport dimensions for screenshots and emulation
CHROME_DEVTOOLS_VIEWPORT_WIDTH=1920
CHROME_DEVTOOLS_VIEWPORT_HEIGHT=1080

# Emulate mobile devices
CHROME_DEVTOOLS_EMULATE_MOBILE=false

# Network throttling: "No emulation", "Offline", "Slow 3G", "Fast 3G", "Slow 4G", "Fast 4G"
# Leave empty for no throttling
CHROME_DEVTOOLS_NETWORK_THROTTLE=

# CPU throttling rate (1-20, where 1 = no throttling, 20 = 20x slower)
# Leave empty for no throttling
CHROME_DEVTOOLS_CPU_THROTTLE=
